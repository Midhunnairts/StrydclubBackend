PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP for Email OTPs & Confirmations
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# MSG91 Configuration (SMS, WhatsApp, SendOTP & Event Flows)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_REGISTRATION_FLOW_ID=

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
CASHFREE_APP_ID=...
CASHFREE_SECRET_KEY=...
CASHFREE_ENV=TEST
